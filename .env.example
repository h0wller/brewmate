# Бесплатный AI (серверная функция api/vision.ts). Задаются в Vercel → Settings → Environment Variables.
# Достаточно одного ключа; если задано несколько, при ошибке или лимите берётся следующий.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
QWEN_API_KEY=

# Необязательно: сменить модель без обновления кода (названия у бесплатных тарифов меняются)
# GEMINI_MODEL=
# GROQ_MODEL=
# OPENROUTER_MODEL=
# QWEN_MODEL=

# Необязательный OpenAI-compatible агрегатор с поддержкой vision (например, FreeLLMAPI).
# Только HTTPS; ключ остаётся на сервере. Требуются все три значения.
# AI_COMPAT_API_KEY=
# AI_COMPAT_BASE_URL=https://api.example.com/v1
# AI_COMPAT_MODEL=vision-model-name
# AI_COMPAT_PROVIDER_ID=free-aggregator

# Лимиты запросов в сутки (по умолчанию 10 на человека и 500 на всех)
# AI_LIMIT_PER_USER=10
# AI_LIMIT_GLOBAL=500

# Общие счётчики между экземплярами функции (Upstash Redis, бесплатный тариф, Vercel Marketplace).
# Без них лимиты и cooldowns считаются в памяти одного экземпляра и точны лишь приблизительно.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
